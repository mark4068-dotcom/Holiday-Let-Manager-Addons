[Unit]
Description=HLM Crossjack kiosk monitoring and control agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=%h/.local/share/hlm-kiosk-agent/venv/bin/python %h/.local/share/hlm-kiosk-agent/hlm_kiosk_agent.py
Restart=always
RestartSec=10
UMask=0077

# Filesystem namespace hardening such as PrivateTmp/ProtectSystem/ProtectHome
# cannot be used here. In a per-user service those settings map host root to
# nobody, which makes sudo reject its own root-owned executable and config.
# The agent remains an unprivileged process and sudoers permits only the exact
# /usr/bin/systemctl reboot command.

[Install]
WantedBy=default.target
