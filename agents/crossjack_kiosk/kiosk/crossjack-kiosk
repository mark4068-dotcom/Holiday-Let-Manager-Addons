#!/bin/bash

set -u

CONFIG_FILE="${HOME}/.config/crossjack-kiosk.env"
PROFILE_DIR="${HOME}/.config/chromium-crossjack"
WVKBD_BIN="${HOME}/.local/opt/wvkbd/usr/bin/wvkbd-mobintl"
EXTERNAL_WINDOW_EXTENSION="${HOME}/.local/share/crossjack-kiosk/external-window-controller"
CHROMIUM_BIN="/usr/lib/chromium/chromium"
ATTRACT_ONCE_FILE="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/crossjack-attract-once"

if [[ -r "${CONFIG_FILE}" ]]; then
  # shellcheck disable=SC1090
  source "${CONFIG_FILE}"
fi

: "${KIOSK_URL:=http://192.168.0.236:8123/crossjack-guest}"

# Cache the locked-down guest presentation for this browser. The dashboard's
# labelled navigation strip replaces Home Assistant's icon-only header tabs.
KIOSK_MODE_PARAMS="hide_header&hide_sidebar&hide_menubutton&hide_search&hide_assistant&hide_overflow&cache"
if [[ "${KIOSK_URL}" == *\?* ]]; then
  KIOSK_LAUNCH_URL="${KIOSK_URL}&${KIOSK_MODE_PARAMS}"
else
  KIOSK_LAUNCH_URL="${KIOSK_URL}?${KIOSK_MODE_PARAMS}"
fi

mkdir -p "${PROFILE_DIR}"
mkdir -p "${HOME}/.cache"

# Allow the network and the Wayland desktop to settle after boot. Chromium will
# still show its normal offline page if Home Assistant itself is unavailable.
for _attempt in $(seq 1 60); do
  if ip route show default | grep -q '^default '; then
    break
  fi
  sleep 1
done
sleep 3

# wvkbd uses the Wayland layer shell, so it can reserve space beneath a
# maximized Chromium window. Start it hidden; the monitoring agent can show or
# hide it with SIGUSR2 and SIGUSR1.
if [[ -x "${WVKBD_BIN}" ]] && ! pgrep -f "^${WVKBD_BIN}( |$)" >/dev/null; then
  "${WVKBD_BIN}" \
    --hidden \
    -H 320 \
    -L 320 \
    --fn "DejaVu Sans 24" \
    >>"${HOME}/.cache/crossjack-wvkbd.log" 2>&1 &
fi

while true; do
  LAUNCH_URL="${KIOSK_LAUNCH_URL}"
  if [[ -f "${ATTRACT_ONCE_FILE}" ]]; then
    rm -f -- "${ATTRACT_ONCE_FILE}"
    LAUNCH_URL="${LAUNCH_URL}&crossjack_attract=1"
  fi

  # Invoke the real Chromium binary. Raspberry Pi OS's /usr/bin/chromium
  # wrapper can append an empty --load-extension option after ours, which
  # prevents the external-window controller from loading.
  "${CHROMIUM_BIN}" \
    --app="${LAUNCH_URL}" \
    --start-maximized \
    --force-renderer-accessibility \
    --enable-remote-extensions \
    --show-component-extension-options \
    --enable-gpu-rasterization \
    --disable-pings \
    --media-router=0 \
    --disable-dev-shm-usage \
    --use-angle=gles \
    --no-first-run \
    --no-default-browser-check \
    --noerrdialogs \
    --disable-session-crashed-bubble \
    --disable-translate \
    --disable-features=Translate,TranslateUI,DisableLoadExtensionCommandLineSwitch \
    --disable-pinch \
    --load-extension="${EXTERNAL_WINDOW_EXTENSION}" \
    --ozone-platform=wayland \
    --enable-wayland-ime \
    --wayland-text-input-version=3 \
    --overscroll-history-navigation=0 \
    --password-store=basic \
    --remote-debugging-address=127.0.0.1 \
    --remote-debugging-port=9222 \
    --user-data-dir="${PROFILE_DIR}"

  # If Chromium is closed or crashes, restore the guest display.
  sleep 2
done
