{
  "title": "Crossjack Kiosk",
  "path": "crossjack-kiosk",
  "icon": "mdi:monitor-dashboard",
  "type": "sections",
  "max_columns": 3,
  "sections": [
    {
      "type": "grid",
      "column_span": 2,
      "cards": [
        {
          "type": "heading",
          "heading": "Kiosk health",
          "icon": "mdi:heart-pulse"
        },
        {
          "type": "tile",
          "entity": "binary_sensor.crossjack_guest_kiosk_online",
          "name": "Pi online",
          "color": "green"
        },
        {
          "type": "tile",
          "entity": "binary_sensor.crossjack_guest_kiosk_kiosk_browser",
          "name": "Guest dashboard",
          "color": "green"
        },
        {
          "type": "tile",
          "entity": "binary_sensor.crossjack_guest_kiosk_display_connected",
          "name": "Display",
          "color": "green"
        },
        {
          "type": "tile",
          "entity": "binary_sensor.crossjack_guest_kiosk_touchscreen_connected",
          "name": "Touchscreen",
          "color": "green"
        },
        {
          "type": "tile",
          "entity": "binary_sensor.crossjack_guest_kiosk_tailscale_connected",
          "name": "Remote support",
          "color": "green"
        },
        {
          "type": "tile",
          "entity": "binary_sensor.crossjack_guest_kiosk_hardware_warning",
          "name": "Hardware warning",
          "color": "red"
        },
        {
          "type": "gauge",
          "entity": "sensor.crossjack_guest_kiosk_cpu_temperature",
          "name": "CPU temperature",
          "min": 20,
          "max": 90,
          "needle": true,
          "severity": {
            "green": 20,
            "yellow": 70,
            "red": 80
          }
        },
        {
          "type": "gauge",
          "entity": "sensor.crossjack_guest_kiosk_memory_used",
          "name": "Memory used",
          "min": 0,
          "max": 100,
          "needle": true,
          "severity": {
            "green": 0,
            "yellow": 75,
            "red": 90
          }
        },
        {
          "type": "gauge",
          "entity": "sensor.crossjack_guest_kiosk_disk_used",
          "name": "Disk used",
          "min": 0,
          "max": 100,
          "needle": true,
          "severity": {
            "green": 0,
            "yellow": 75,
            "red": 85
          }
        }
      ]
    },
    {
      "type": "grid",
      "cards": [
        {
          "type": "heading",
          "heading": "Remote controls",
          "icon": "mdi:remote"
        },
        {
          "type": "button",
          "entity": "button.crossjack_guest_kiosk_refresh_dashboard",
          "name": "Refresh dashboard",
          "icon": "mdi:refresh",
          "tap_action": {
            "action": "perform-action",
            "perform_action": "button.press",
            "target": {
              "entity_id": "button.crossjack_guest_kiosk_refresh_dashboard"
            }
          }
        },
        {
          "type": "button",
          "entity": "button.crossjack_guest_kiosk_activate_screensaver",
          "name": "Activate screensaver",
          "icon": "mdi:monitor-shimmer",
          "tap_action": {
            "action": "perform-action",
            "perform_action": "button.press",
            "target": {
              "entity_id": "button.crossjack_guest_kiosk_activate_screensaver"
            }
          }
        },
        {
          "type": "button",
          "entity": "button.crossjack_guest_kiosk_restart_kiosk_browser",
          "name": "Restart browser",
          "icon": "mdi:web-refresh",
          "tap_action": {
            "action": "perform-action",
            "perform_action": "button.press",
            "target": {
              "entity_id": "button.crossjack_guest_kiosk_restart_kiosk_browser"
            },
            "confirmation": {
              "text": "Restart the Crossjack kiosk browser?"
            }
          }
        },
        {
          "type": "button",
          "entity": "button.crossjack_guest_kiosk_screen_on",
          "name": "Screen on",
          "icon": "mdi:monitor",
          "tap_action": {
            "action": "perform-action",
            "perform_action": "button.press",
            "target": {
              "entity_id": "button.crossjack_guest_kiosk_screen_on"
            }
          }
        },
        {
          "type": "button",
          "entity": "button.crossjack_guest_kiosk_screen_off",
          "name": "Screen off",
          "icon": "mdi:monitor-off",
          "tap_action": {
            "action": "perform-action",
            "perform_action": "button.press",
            "target": {
              "entity_id": "button.crossjack_guest_kiosk_screen_off"
            },
            "confirmation": {
              "text": "Turn off the Crossjack kiosk screen? Use Screen on to restore it."
            }
          }
        },
        {
          "type": "button",
          "entity": "button.crossjack_guest_kiosk_show_keyboard",
          "name": "Show keyboard",
          "icon": "mdi:keyboard",
          "tap_action": {
            "action": "perform-action",
            "perform_action": "button.press",
            "target": {
              "entity_id": "button.crossjack_guest_kiosk_show_keyboard"
            }
          }
        },
        {
          "type": "button",
          "entity": "button.crossjack_guest_kiosk_hide_keyboard",
          "name": "Hide keyboard",
          "icon": "mdi:keyboard-off",
          "tap_action": {
            "action": "perform-action",
            "perform_action": "button.press",
            "target": {
              "entity_id": "button.crossjack_guest_kiosk_hide_keyboard"
            }
          }
        },
        {
          "type": "button",
          "entity": "button.crossjack_guest_kiosk_run_health_report",
          "name": "Update health now",
          "icon": "mdi:heart-pulse",
          "tap_action": {
            "action": "perform-action",
            "perform_action": "button.press",
            "target": {
              "entity_id": "button.crossjack_guest_kiosk_run_health_report"
            }
          }
        },
        {
          "type": "button",
          "entity": "button.crossjack_guest_kiosk_reboot_pi",
          "name": "Reboot Pi",
          "icon": "mdi:restart-alert",
          "tap_action": {
            "action": "perform-action",
            "perform_action": "button.press",
            "target": {
              "entity_id": "button.crossjack_guest_kiosk_reboot_pi"
            },
            "confirmation": {
              "text": "Reboot the Crossjack kiosk Pi? The display will be unavailable for about one minute."
            }
          }
        },
        {
          "type": "entities",
          "title": "Last command",
          "entities": [
            "sensor.crossjack_guest_kiosk_last_command",
            "sensor.crossjack_guest_kiosk_last_command_result"
          ]
        }
      ]
    },
    {
      "type": "grid",
      "column_span": 3,
      "cards": [
        {
          "type": "heading",
          "heading": "Diagnostics",
          "icon": "mdi:information-outline"
        },
        {
          "type": "entities",
          "entities": [
            "sensor.crossjack_guest_kiosk_last_seen",
            "sensor.crossjack_guest_kiosk_uptime",
            "sensor.crossjack_guest_kiosk_local_ip_address",
            "sensor.crossjack_guest_kiosk_tailscale_ip",
            "sensor.crossjack_guest_kiosk_disk_free",
            "sensor.crossjack_guest_kiosk_cpu_load_1_minute",
            "sensor.crossjack_guest_kiosk_pending_updates",
            "sensor.crossjack_guest_kiosk_throttling_flags"
          ]
        },
        {
          "type": "history-graph",
          "title": "Temperature and resource history",
          "hours_to_show": 24,
          "entities": [
            "sensor.crossjack_guest_kiosk_cpu_temperature",
            "sensor.crossjack_guest_kiosk_memory_used",
            "sensor.crossjack_guest_kiosk_disk_used"
          ]
        }
      ]
    }
  ]
}
